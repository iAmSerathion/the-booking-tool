# Copy to .env.local and fill in. Every variable is read by lib/config.ts.

# --- Required ---

# Public origin of this instance, no path. All links in mails and widgets use it.
APP_URL=http://localhost:3000

# Supabase project (local: `npm run stack:up` writes these to .env.e2e.local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud OAuth web client with the Calendar API enabled.
# Redirect URI: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bearer token for POST <APP_URL>/api/jobs/scheduler, at least 32 characters (e.g. `openssl rand -hex 32`).
SCHEDULER_SECRET=

# Outgoing mail, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Bookings <bookings@example.com>"

# --- Optional ---

# Name and logo shown on booking pages and in mails.
BRAND_NAME=
BRAND_LOGO_URL=
# Your privacy policy and imprint, linked on booking pages.
PRIVACY_URL=
IMPRINT_URL=
# de or en (default de).
DEFAULT_LOCALE=
# IANA time zone for new accounts (default Europe/Berlin).
DEFAULT_TIMEZONE=
# Who may sign in with Google: members an admin invited, plus anyone from these comma-separated Google Workspace
# domains (they get a member profile on first sign-in). Empty: invited members only, any Google account works.
ALLOWED_GOOGLE_DOMAINS=
# Optional Workspace domain passed to Google as the "hd" hint, so the account chooser shows only that domain.
GOOGLE_HOSTED_DOMAIN=
# Email of the first admin. On a fresh install the first Google sign-in with this address creates the admin profile;
# once an active admin exists it has no effect.
INITIAL_ADMIN_EMAIL=
# true: the Google calendar a member connects must use the same email as their sign-in (default false).
REQUIRE_SAME_GOOGLE_EMAIL=
# TEST ONLY, never set in production: base URL of the Google fake used by the e2e tests (tests/e2e/google-fake.mjs).
# Only localhost or 127.0.0.1 is accepted.
GOOGLE_FAKE_URL=
# TEST ONLY, never set in production: true lets the scheduler run on a simulated clock (x-test-now header, scoped to one
# booking or user). Refused unless APP_URL is localhost, 127.0.0.1 or [::1].
SCHEDULER_TEST_CLOCK=
# true only behind a proxy that appends the client address to X-Forwarded-For (default false). Then booking attempts
# are limited per client address. Without it the address is unknown, so attempts are limited per invitee email, plus a
# global ceiling of 20 times the limit; a flood of many different emails can still reach that ceiling and pause
# booking. Set it in production behind a proxy.
TRUST_PROXY_HEADERS=
# Booking attempts per minute and client address, or per email without TRUST_PROXY_HEADERS (default 10).
BOOKING_ATTEMPTS_PER_MINUTE=
# Signed booking.created / .rescheduled / .cancelled / .host_changed events (README "Webhooks"). The secret needs 32+
# characters. Without a URL, events are dropped instead of kept for later.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Comma-separated origins (e.g. https://www.example.com) that may embed widgets which list no allowed origins of their
# own. Plain http only for localhost or 127.0.0.1. Empty: such widgets can only be tried in the admin playground.
EMBED_ALLOWED_ORIGINS=

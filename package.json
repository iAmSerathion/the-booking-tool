{
  "name": "the-booking-tool",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:calendar": "node scripts/dev-calendar.mjs",
    "dev:login": "node scripts/dev-login.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:test": "bash scripts/db-test.sh",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:lint": "bash scripts/db-lint.sh",
    "stack:up": "bash scripts/stack/up.sh",
    "stack:down": "bash scripts/stack/down.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.6",
    "nodemailer": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "mailparser": "3.14.2",
    "pg": "8.23.1",
    "smtp-server": "3.21.3",
    "supabase": "2.122.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
